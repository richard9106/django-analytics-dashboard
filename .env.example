DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,nuviamy.com,www.nuviamy.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://nuviamy.com,https://www.nuviamy.com

# PostgreSQL is used when POSTGRES_DB is set. Leave these empty for local SQLite fallback.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# File storage. Leave DJANGO_STORAGE_BACKEND empty for local MEDIA_ROOT storage.
# Set to r2 in production to use Cloudflare R2 through the S3-compatible API.
DJANGO_STORAGE_BACKEND=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=nuviamy
AWS_S3_ENDPOINT_URL=https://<account-id>.us.r2.cloudflarestorage.com
AWS_S3_REGION_NAME=auto

# Google OAuth for Gmail, Calendar, and Drive integrations.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://nuviamy.com/settings/integrations/google/callback/
